# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# DynamoDB
DYNAMODB_TABLE_NAME=microagent-data
# DYNAMODB_ENDPOINT_URL=http://localhost:8000  # Uncomment for local development

# S3
S3_BUCKET_NAME=microagent-artifacts
# S3_ENDPOINT_URL=http://localhost:4566  # Uncomment for LocalStack

# Amazon Cognito
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connections/google/callback

# Amazon SES
SES_SENDER_EMAIL=noreply@microagent.app
SES_REGION=us-east-1

# API Configuration
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
API_PREFIX=/api

# Security
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Cedar Authorization
CEDAR_POLICY_STORE_PATH=policies/cedar

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=MicroAgent
APP_VERSION=1.0.0

# Workflow Configuration
WORKFLOW_TIMEOUT_SECONDS=300
MAX_WORKFLOW_STEPS=50

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=180

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_APPROVAL_FLOW=true
ENABLE_TIMELINE=true
ENABLE_SNAPSHOTS=true
